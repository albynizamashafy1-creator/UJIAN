# Salin menjadi .env dan GANTI semua password
TZ=Asia/Jayapura

# Database
DB_ROOT_PASSWORD=GantiRootPassword!
DB_USER=moodle
DB_PASSWORD=GantiDbPassword!
DB_NAME=moodle

# Admin Moodle
MOODLE_USERNAME=admin
MOODLE_PASSWORD=GantiAdminPassword!
MOODLE_EMAIL=admin@sekolah.sch.id
MOODLE_SITE_NAME=Sistem Ujian Online
MOODLE_HOST=localhost:8080
MOODLE_REVERSEPROXY=no
MOODLE_SSLPROXY=no

# SMTP (default: Mailpit testing)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_PROTOCOL=

# Jitsi (bagikan layar)
JITSI_PUBLIC_URL=http://localhost:8000
JVB_ADVERTISE_IPS=192.168.1.10
JICOFO_AUTH_PASSWORD=GantiJicofoPass
JICOFO_COMPONENT_SECRET=GantiJicofoSecret
JVB_AUTH_PASSWORD=GantiJvbPass

# Mode HTTPS (profile proxy): isi domain lalu set
#   MOODLE_REVERSEPROXY=yes, MOODLE_SSLPROXY=yes,
#   MOODLE_HOST=ujian.sekolah.sch.id, JITSI_PUBLIC_URL=https://meet.sekolah.sch.id
MOODLE_DOMAIN=ujian.example.com
JITSI_DOMAIN=meet.example.com

# Port (opsional)
APP_PORT=8080
MAILPIT_PORT=8025
PMA_PORT=8081
KUMA_PORT=3001
DOZZLE_PORT=9999
